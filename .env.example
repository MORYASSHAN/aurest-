# Contact form email settings.
# Copy this file to .env.local and fill in the values. Never commit .env.local.
#
# Gmail setup (for aurestbiotech@gmail.com):
#   1. Turn on 2-Step Verification for the Google account.
#   2. Create an App Password: https://myaccount.google.com/apppasswords
#   3. Paste the 16-character app password below as SMTP_PASS.

SMTP_USER=aurestbiotech@gmail.com
SMTP_PASS=

# Where form messages are delivered (defaults to aurestbiotech@gmail.com)
CONTACT_TO=aurestbiotech@gmail.com

# Optional — only change if not using Gmail
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
